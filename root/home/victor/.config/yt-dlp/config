# Always download best video + audio
-f bestvideo+bestaudio/best

# Output folder and filename
-o ~/Videos/%(title)s.%(ext)s

# Use aria2 for faster downloads
--downloader aria2c

# Continue interrupted downloads
-c

# Better filenames
--restrict-filenames

# Embed metadata
--embed-metadata

# Embed thumbnail if available
--embed-thumbnail

# Show progress
--progress
