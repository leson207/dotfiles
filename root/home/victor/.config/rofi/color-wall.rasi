* {
    primary: #5e621b;
    primary-fixed: #e4e892;
    primary-fixed-dim: #c7cc79;
    on-primary: #ffffff;
    on-primary-fixed: #1b1d00;
    on-primary-fixed-variant: #464a02;
    primary-container: #e4e892;
    on-primary-container: #1b1d00;
    secondary: #5f6044;
    secondary-fixed: #e5e5c0;
    secondary-fixed-dim: #c8c9a6;
    on-secondary: #ffffff;
    on-secondary-fixed: #1c1d06;
    on-secondary-fixed-variant: #47482e;
    secondary-container: #e5e5c0;
    on-secondary-container: #1c1d06;
    tertiary: #3c6659;
    tertiary-fixed: #beecdb;
    tertiary-fixed-dim: #a3d0bf;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #002018;
    on-tertiary-fixed-variant: #244e41;
    tertiary-container: #beecdb;
    on-tertiary-container: #002018;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #fcfaec;
    on-surface: #1c1c14;
    on-surface-variant: #47473b;
    outline: #787869;
    outline-variant: #c9c7b6;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #313128;
    inverse-on-surface: #f4f1e4;
    inverse-primary: #c7cc79;
    surface-dim: #dddacd;
    surface-bright: #fcfaec;
    surface-container-lowest: #ffffff;
    surface-container-low: #f7f4e7;
    surface-container: #f1eee1;
    surface-container-high: #ebe8db;
    surface-container-highest: #e5e3d6;
}

* {
    background:            @surface;
    foreground:            @on-surface;

    selected:              @primary-container;
    selected-foreground:   @on-primary-container;

    input-background:      @surface-container;
    input-foreground:      @on-surface;

    border-color:          @outline;
}



configuration {
	modi:                       "drun";
    show-icons:                 true;
    display-drun:               " ";
	drun-display-format:        "{name}";
}

/*
└── window
    └── mainbox
        ├── inputbar
        │   ├── prompt
        │   └── entry
        └── listview
            └── elements
*/

window {
    width:                       1000px;
    height:                      575px;
    border:                      0px;
    border-radius:               12px;
    border-color:                @selected;
    background-color:            @background;
}


mainbox {
    spacing:                     10px;
    padding:                     10px;
    border:                      2px;
    border-radius:               12px 12px 12px 12px;
    border-color:                @selected;
    background-color:            @background;
    children:                    ["listview" ];
}

listview {
    columns:                     5;
    lines:                       3;
    scrollbar:                   false;
    layout:                      vertical;
    border:                      0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
}

element {
    spacing:                     6px;
    padding:                     4px;
    border:                      0px;
    border-radius:               10px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 vertical;
}

element normal.normal {
    background-color: transparent;
    text-color:       @on-surface-variant;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}
element selected.normal {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element-icon {
    size:             140px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color:            transparent;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    padding: 0px;
    margin: 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
