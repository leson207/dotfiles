* {
    primary: #6750a4;
    primary-fixed: #eaddff;
    primary-fixed-dim: #6750a4;
    on-primary: #ffffff;
    on-primary-fixed: #ffffff;
    on-primary-fixed-variant: #ffffff;
    primary-container: #eaddff;
    on-primary-container: #1d1b20;
    secondary: #625b71;
    secondary-fixed: #625b71;
    secondary-fixed-dim: #625b71;
    on-secondary: #ffffff;
    on-secondary-fixed: #ffffff;
    on-secondary-fixed-variant: #ffffff;
    secondary-container: #ece6ee;
    on-secondary-container: #1d1b20;
    tertiary: #625b71;
    tertiary-fixed: #625b71;
    tertiary-fixed-dim: #625b71;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #ffffff;
    on-tertiary-fixed-variant: #ffffff;
    tertiary-container: #ece6ee;
    on-tertiary-container: #1d1b20;
    error: #b3261e;
    on-error: #ffffff;
    error-container: #f9dedc;
    on-error-container: #410e0b;
    surface: #fef7ff;
    on-surface: #1d1b20;
    on-surface-variant: #49454e;
    outline: #7a757f;
    outline-variant: #e7e0eb;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #141218;
    inverse-on-surface: #e6e0e9;
    inverse-primary: #d0bcff;
    surface-dim: #f2ecf4;
    surface-bright: #fef7ff;
    surface-container-lowest: #fef7ff;
    surface-container-low: #fef7ff;
    surface-container: #f2ecf4;
    surface-container-high: #ece6ee;
    surface-container-highest: #e6e0e9;
}

* {
    background:            @surface;
    foreground:            @on-surface;

    selected:              @primary-container;
    selected-foreground:   @on-primary-container;

    input-background:      @surface-container;
    input-foreground:      @on-surface;

    border-color:          @outline;
}



configuration {
	modi:                       "drun";
    show-icons:                 true;
    display-drun:               " ";
	drun-display-format:        "{name}";
}

/*
└── window
    └── mainbox
        ├── inputbar
        │   ├── prompt
        │   └── entry
        └── listview
            └── elements
*/

window {
    width:                       1000px;
    height:                      575px;
    border:                      0px;
    border-radius:               12px;
    border-color:                @selected;
    background-color:            @background;
}


mainbox {
    spacing:                     10px;
    padding:                     10px;
    border:                      2px;
    border-radius:               12px 12px 12px 12px;
    border-color:                @selected;
    background-color:            @background;
    children:                    ["listview" ];
}

listview {
    columns:                     5;
    lines:                       3;
    scrollbar:                   false;
    layout:                      vertical;
    border:                      0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
}

element {
    spacing:                     6px;
    padding:                     4px;
    border:                      0px;
    border-radius:               10px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    orientation:                 vertical;
}

element normal.normal {
    background-color: transparent;
    text-color:       @on-surface-variant;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}
element selected.normal {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element-icon {
    size:             140px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    background-color:            transparent;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    padding: 0px;
    margin: 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
